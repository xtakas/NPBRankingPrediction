<div class="table-scroll">
    <FluentDataGrid Items="@Entries.AsQueryable()" Class="standings-grid" GenerateHeader="DataGridGeneratedHeaderType.Sticky">
        <TemplateColumn Title="順位" Align="DataGridCellAlignment.Center" Width="2.2rem" Class="standings-grid-rank">
            @context.Rank
        </TemplateColumn>
        <TemplateColumn Title="チーム名" Width="1fr" Class="standings-grid-team">
            <TeamBadge TeamCode="@context.TeamCode" />
        </TemplateColumn>
        <PropertyColumn Property="@(e => e.Wins)" Title="勝" Align="DataGridCellAlignment.Center" Width="2.2rem" />
        <PropertyColumn Property="@(e => e.Losses)" Title="敗" Align="DataGridCellAlignment.Center" Width="2.2rem" />
        <PropertyColumn Property="@(e => e.Draws)" Title="分" Align="DataGridCellAlignment.Center" Width="2.2rem" />
        <TemplateColumn Title="ゲーム差" Align="DataGridCellAlignment.Center" Width="3rem">
            @FormatGamesBehind(context)
        </TemplateColumn>
    </FluentDataGrid>
</div>

@code {
    [Parameter, EditorRequired]
    public List<StandingsEntry> Entries { get; set; } = [];

    // ゲーム差0は首位(Rank==1)のみ「-」。首位と同率のチームは0.0として表示する。
    private static string FormatGamesBehind(StandingsEntry entry)
        => entry.Rank == 1 ? "-" : entry.GamesBehind.ToString("0.0");
}

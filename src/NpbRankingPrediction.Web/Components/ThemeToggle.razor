@inject IThemeService ThemeService
@inject ThemeState ThemeState
@inject IJSRuntime JS

<div class="theme-toggle" role="group" aria-label="表示テーマ切替">
    @foreach (var option in Options)
    {
        <button type="button"
                class="theme-toggle-button @(selectedMode == option.Mode ? "active" : "")"
                aria-pressed="@(selectedMode == option.Mode ? "true" : "false")"
                @onclick="@(() => SelectAsync(option.Mode))">
            @option.Label
        </button>
    }
</div>

@code {
    private const string StorageKey = "npb-theme-mode";

    // 「自動」ボタンは廃止したが、ユーザーが一度もライト/ダークを明示選択していない間は
    // 引き続きOS設定に追従させたい。そのため未選択時はSetThemeAsyncを呼ばずFluentUI側の
    // 既定(システム追従)のままにし、このトグルの押下表示だけ現在の解決結果に合わせる。
    private static readonly (ThemeMode Mode, string Label)[] Options =
    [
        (ThemeMode.Light, "ライト"),
        (ThemeMode.Dark, "ダーク"),
    ];

    private ThemeMode selectedMode = ThemeMode.Light;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        var isDark = await ThemeService.IsDarkModeAsync();
        selectedMode = stored switch
        {
            "light" => ThemeMode.Light,
            "dark" => ThemeMode.Dark,
            _ => isDark ? ThemeMode.Dark : ThemeMode.Light,
        };

        ThemeState.SetDark(isDark);
        StateHasChanged();
    }

    private async Task SelectAsync(ThemeMode mode)
    {
        selectedMode = mode;
        await ThemeService.SetThemeAsync(mode);

        var value = mode == ThemeMode.Dark ? "dark" : "light";
        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, value);

        ThemeState.SetDark(await ThemeService.IsDarkModeAsync());
    }
}

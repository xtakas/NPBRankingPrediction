@*
    予想者を行、順位(1位〜6位)を列にした転置表。
    予想者数が多くても横幅が「順位6列+的中列」で一定になり、スマホでも横スクロールなしで
    各予想者の的中状況を縦にたどって見られる。
*@
<div class="table-scroll">
    <FluentDataGrid Items="@PredictorIds.AsQueryable()"
                    Class="@("comparison-grid " + (League == League.Central ? "prediction-table--central" : "prediction-table--pacific"))"
                    GenerateHeader="DataGridGeneratedHeaderType.Sticky">
        <TemplateColumn Title="予想者" Width="5.6rem" Class="comparison-grid-predictor">
            <span class="predictor-badge" title="@($"#{context}")">@context</span>
            <span class="predictor-name">@NameFor(context)</span>
        </TemplateColumn>
        @foreach (var rank in Enumerable.Range(1, RankCount))
        {
            <TemplateColumn Title="@($"{rank} 位")" Align="DataGridCellAlignment.Center" Width="2.1rem">
                @{
                    var predictedTeam = PredictedTeamAt(context, rank);
                    var isHit = predictedTeam is not null && predictedTeam == ActualTeamAt(rank);
                    var isConfirmedHit = isHit && (IsSeasonFinal || IsRankConfirmedAt(rank));
                }
                <span class="grid-cell-highlight @(isConfirmedHit ? "cell-hit-confirmed" : isHit ? "cell-hit" : "")">
                    @if (predictedTeam is not null)
                    {
                        <TeamBadge TeamCode="@predictedTeam" ShowFullName="false" />
                    }
                    else
                    {
                        <span>-</span>
                    }
                </span>
            </TemplateColumn>
        }
        <TemplateColumn Title="的中" Align="DataGridCellAlignment.Center" Width="2.8rem" Class="fw-bold">
            @MatchesFor(context) / @RankCount
        </TemplateColumn>
        <TemplateColumn Title="合計" Align="DataGridCellAlignment.Center" Width="3.2rem" Class="total-column">
            <span class="grid-cell-highlight @(IsCarryoverClear(context) ? "cell-hit fw-bold" : "")">@TotalMatchesFor(context) / 12</span>
        </TemplateColumn>
    </FluentDataGrid>
</div>

@code {
    private const int RankCount = 6;

    [Parameter, EditorRequired]
    public List<StandingsEntry> Entries { get; set; } = [];

    [Parameter, EditorRequired]
    public Dictionary<string, PredictionEntry> Predictions { get; set; } = [];

    [Parameter]
    public Dictionary<string, string> Names { get; set; } = [];

    [Parameter, EditorRequired]
    public List<PredictorScore> Scores { get; set; } = [];

    [Parameter, EditorRequired]
    public League League { get; set; }

    /// <summary>trueなら残り試合の有無に関わらず、的中している行はすべて確定表示にする。
    /// (シーズン確定後は近似判定に頼らず全順位が確定しているとみなせるため。)</summary>
    [Parameter]
    public bool IsSeasonFinal { get; set; }

    private List<string> PredictorIds => Predictions.Keys.ToList();

    private string? ActualTeamAt(int rank) => Entries.FirstOrDefault(e => e.Rank == rank)?.TeamCode;

    private bool IsRankConfirmedAt(int rank) => Entries.FirstOrDefault(e => e.Rank == rank)?.IsRankConfirmed ?? false;

    private string? PredictedTeamAt(string predictorId, int rank)
    {
        if (!Predictions.TryGetValue(predictorId, out var entry))
        {
            return null;
        }

        var order = League == League.Central ? entry.Central : entry.Pacific;
        return rank >= 1 && rank <= order.Count ? order[rank - 1] : null;
    }

    private int MatchesFor(string predictorId)
    {
        var score = Scores.FirstOrDefault(s => s.PredictorId == predictorId);
        if (score is null)
        {
            return 0;
        }

        return League == League.Central ? score.CentralMatches : score.PacificMatches;
    }

    private int TotalMatchesFor(string predictorId)
        => Scores.FirstOrDefault(s => s.PredictorId == predictorId)?.TotalMatches ?? 0;

    private bool IsCarryoverClear(string predictorId)
        => Scores.FirstOrDefault(s => s.PredictorId == predictorId)?.IsCarryoverClear ?? false;

    private string NameFor(string predictorId)
        => Names.TryGetValue(predictorId, out var name) ? name : "";
}
